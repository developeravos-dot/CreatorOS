// =========================================================
// CreatorOS AI Organization Persistence — Pack 5C
// Persistent aggregate envelope for the Pack 4 workspace.
// Existing AgentTeam and AgentMission models remain intact.
// =========================================================

model AiOrganizationWorkspaceState {
  id           String   @id @default(uuid())
  workspaceKey String   @unique
  projectId    String?
  version      Int      @default(1)
  state        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  executionSessions ExecutionSession[]

  @@index([projectId])
  @@index([updatedAt])
}

// =========================================================
// CreatorOS AI Team Execution Engine — Pack 6A
// Execution Domain Foundation
// =========================================================

model ExecutionSession {
  id                    String          @id @default(uuid())
  workspaceId           String
  projectId             String?
  sessionKey            String          @unique
  name                  String
  objective             String?
  status                ExecutionStatus @default(PENDING)
  progress              Int             @default(0)
  requiresHumanApproval Boolean         @default(false)
  approvedBy            String?
  approvedAt            DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  metadata              Json?
  context               Json?
  finalOutput           Json?
  errorMessage          String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  workspace AiOrganizationWorkspaceState @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  jobs        ExecutionJob[]
  auditEvents ExecutionAuditEvent[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model ExecutionJob {
  id                String          @id @default(uuid())
  sessionId         String
  jobKey            String
  name              String
  description       String?
  assignedAgentId   String?
  runtimeProviderId String?
  capability        String?
  status            ExecutionStatus @default(PENDING)
  priority          Int             @default(0)
  sequence          Int
  progress          Int             @default(0)
  retryCount        Int             @default(0)
  maxRetries        Int             @default(3)
  requiresApproval  Boolean         @default(false)
  approvedBy        String?
  approvedAt        DateTime?
  input             Json?
  output            Json?
  metadata          Json?
  errorMessage      String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  session ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  steps ExecutionStep[]

  @@unique([sessionId, jobKey])
  @@index([sessionId])
  @@index([assignedAgentId])
  @@index([runtimeProviderId])
  @@index([capability])
  @@index([status])
  @@index([priority])
  @@index([sequence])
}

model ExecutionStep {
  id                String          @id @default(uuid())
  jobId             String
  stepKey           String
  name              String
  description       String?
  sequence          Int
  status            ExecutionStatus @default(PENDING)
  runtimeProviderId String?
  operation         String?
  progress          Int             @default(0)
  retryCount        Int             @default(0)
  maxRetries        Int             @default(3)
  requiresApproval  Boolean         @default(false)
  approvedBy        String?
  approvedAt        DateTime?
  input             Json?
  output            Json?
  metadata          Json?
  errorMessage      String?
  startedAt         DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  job ExecutionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  results ExecutionResult[]

  @@unique([jobId, stepKey])
  @@index([jobId])
  @@index([runtimeProviderId])
  @@index([status])
  @@index([sequence])
}

model ExecutionResult {
  id           String   @id @default(uuid())
  stepId       String
  resultType   String
  success      Boolean
  output       Json?
  logs         Json?
  metrics      Json?
  artifacts    Json?
  errorCode    String?
  errorMessage String?
  durationMs   Int?
  createdAt    DateTime @default(now())

  step ExecutionStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([resultType])
  @@index([success])
  @@index([createdAt])
}

model ExecutionAuditEvent {
  id String @id @default(uuid())

  sessionId String
  jobId     String?
  stepId    String?
  resultId  String?

  eventType String
  severity  String @default("INFO")

  status ExecutionStatus?

  message String

  runtimeProviderId String?

  actorType String?
  actorId   String?

  metadata Json?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  session ExecutionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@index([jobId])
  @@index([stepId])
  @@index([resultId])
  @@index([eventType])
  @@index([severity])
  @@index([status])
  @@index([runtimeProviderId])
  @@index([occurredAt])
}
model WorkflowExecutionPersistence {
  id               String   @id
  workflowId       String
  status           String   @default("pending")
  maxParallelSteps Int      @default(1)
  context          Json
  metadata         Json
  activeStepIds    String[]
  failureReason    String?
  startedAt        DateTime?
  pausedAt         DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  version          Int      @default(1)

  checkpoints WorkflowCheckpointPersistence[]
  stepStates  WorkflowStepStatePersistence[]
  events      WorkflowEventPersistence[]
  recoveries  WorkflowRecoveryPersistence[]

  @@index([workflowId])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model WorkflowCheckpointPersistence {
  id               String   @id
  executionId      String
  sequence         Int
  state            Json
  completedStepIds String[]
  activeStepIds    String[]
  checksum         String
  createdAt        DateTime @default(now())

  execution  WorkflowExecutionPersistence @relation(fields: [executionId], references: [id], onDelete: Cascade)
  recoveries WorkflowRecoveryPersistence[]

  @@unique([executionId, sequence])
  @@index([executionId])
  @@index([createdAt])
}

model WorkflowStepStatePersistence {
  id           String   @id
  executionId  String
  stepId       String
  status       String   @default("pending")
  attempt      Int      @default(0)
  input        Json
  output       Json?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)

  execution WorkflowExecutionPersistence @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, stepId])
  @@index([executionId])
  @@index([status])
  @@index([updatedAt])
}

model WorkflowEventPersistence {
  id          String   @id
  executionId String
  sequence    Int
  type        String
  payload     Json
  metadata    Json
  occurredAt  DateTime @default(now())

  execution WorkflowExecutionPersistence @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, sequence])
  @@index([executionId])
  @@index([type])
  @@index([occurredAt])
}

model WorkflowRecoveryPersistence {
  id              String   @id
  executionId     String
  checkpointId    String?
  status          String   @default("pending")
  attempt         Int      @default(1)
  reason          String
  restoredStepIds String[]
  errorMessage    String?
  requestedAt     DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  execution  WorkflowExecutionPersistence  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  checkpoint WorkflowCheckpointPersistence? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  @@index([executionId])
  @@index([checkpointId])
  @@index([status])
  @@index([requestedAt])
}
