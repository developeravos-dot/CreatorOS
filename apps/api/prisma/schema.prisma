  service   String
  status    ObsHealthStatus @default(UNKNOWN)
  latencyMs Float?
  message   String?
  details   Json
  checkedAt DateTime        @default(now())
  createdAt DateTime        @default(now())

  @@index([service, checkedAt])
  @@index([status, checkedAt])
}

model ObsLogEntry {
  id         String      @id @default(cuid())
  service    String
  level      ObsLogLevel
  message    String
  traceId    String?
  spanId     String?
  context    Json
  occurredAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  @@index([service, occurredAt])
  @@index([level, occurredAt])
  @@index([traceId])
}

model ObsTraceSpan {
  id           String    @id @default(cuid())
  traceId      String
  spanId       String    @unique
  parentSpanId String?
  service      String
  operation    String
  status       String
  durationMs   Float?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  attributes   Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

