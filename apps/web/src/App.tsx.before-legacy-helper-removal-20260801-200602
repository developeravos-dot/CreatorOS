            label="القوالب الذكية"
            onClick={() => setView("prompts")}
          />
        </nav>

        <div style={styles.connectionBox}>
          <div
            style={{
              ...styles.connectionDot,
              background: connected ? "#42e8a1" : "#ff5f74",
