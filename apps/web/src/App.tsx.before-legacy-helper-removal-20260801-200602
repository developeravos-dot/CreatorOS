        </header>

        {message && (
          <div style={styles.successMessage}>{message}</div>
        )}

        {error && (
          <div style={styles.errorMessage}>{error}</div>
        )}

        {loading ? (
          <div style={styles.loading}>
            جارٍ تحميل CreatorOS Enterprise...
          </div>
        ) : (
          <>
            {view === "dashboard" && (
              <DashboardPage
                dashboard={dashboard}
                connected={connected}
                busy={busy}
                onCreateProject={createProject}
                onCreateScript={createScript}
                onSchedule={scheduleContent}
                onCreatePrompt={createPrompt}
              />
            )}

            {view === "projects" && (
              <ProjectsPage
                projects={dashboard.projects}
                busy={busy}
                onCreate={createProject}
                onStatus={changeProjectStatus}
                onDelete={deleteProject}
              />
            )}

            {view === "scripts" && (
              <ScriptsPage
                scripts={dashboard.scripts}
                projects={dashboard.projects}
                busy={busy}
                onCreate={createScript}
                onEdit={editScript}
                onStatus={changeScriptStatus}
              />
            )}

            {view === "calendar" && (
              <CalendarPage
                items={dashboard.calendar}
                projects={dashboard.projects}
                busy={busy}
                onCreate={scheduleContent}
              />
            )}

            {view === "prompts" && (
              <PromptsPage
                prompts={dashboard.prompts}
                busy={busy}
                onCreate={createPrompt}
              />
            )}
          </>
        )}      </main>

      <UpdateProjectStatusDialog
        open={selectedProjectForStatus !== null}
        busy={busy}
        error={error}
        project={selectedProjectForStatus}
        onClose={() =>
          setSelectedProjectForStatus(null)
        }
        onSubmit={submitProjectStatus}
      />

      <DeleteProjectDialog
        open={selectedProjectForDelete !== null}
        busy={busy}
        error={error}
        project={selectedProjectForDelete}
        onClose={() =>
          setSelectedProjectForDelete(null)
        }
        onConfirm={confirmDeleteProject}
      />

      <UpdateScriptStatusDialog
        open={selectedScriptForStatus !== null}
        busy={busy}
        error={error}
        script={selectedScriptForStatus}
        onClose={() =>
          setSelectedScriptForStatus(null)
        }
        onSubmit={submitScriptStatus}
      />

      <EditScriptDialog
        open={selectedScriptForEdit !== null}
        busy={busy}
        error={error}
        script={selectedScriptForEdit}
        onClose={() =>
          setSelectedScriptForEdit(null)
        }
        onSubmit={submitEditScript}
      />
      <CreateProjectDialog
        open={createProjectDialogOpen}
        busy={busy}
        error={error}
        onClose={() =>
          setCreateProjectDialogOpen(false)
        }
        onSubmit={submitCreateProject}
      />

      <CreateScriptDialog
        open={createScriptDialogOpen}
        busy={busy}
        error={error}
        projects={dashboard.projects}
        onClose={() =>
          setCreateScriptDialogOpen(false)
        }
        onSubmit={submitCreateScript}
      />

      <ScheduleContentDialog
        open={scheduleContentDialogOpen}
        busy={busy}
        error={error}
        projects={dashboard.projects}
        onClose={() =>
          setScheduleContentDialogOpen(false)
        }
        onSubmit={submitScheduleContent}
      />

      <CreatePromptDialog
        open={createPromptDialogOpen}
        busy={busy}
        error={error}
        onClose={() =>
          setCreatePromptDialogOpen(false)
        }
        onSubmit={submitCreatePrompt}
      />
    </div>
  );
}

function selectPlatform(): EnterprisePlatform | null {
  const value = window.prompt(
    [
      "اختر المنصة:",
      "1 = YouTube",
      "2 = TikTok",
      "3 = YouTube + TikTok",
    ].join("\n"),
    "3",
  );

  if (value === "1") {
    return "YouTube";
  }

  if (value === "2") {
    return "TikTok";
  }

  if (value === "3") {
    return "Both";
  }

  return null;
}

function selectProject(
  projects: EnterpriseProject[],
): EnterpriseProject | null {
  const options = projects
    .map(
      (project, index) =>
        `${index + 1} = ${project.name}`,
    )
    .join("\n");

  const value = window.prompt(
    `اختر المشروع:\n${options}`,
    "1",
  );

  if (!value) {
    return null;
  }

  const index = Number(value) - 1;

  if (
    !Number.isInteger(index) ||
    index < 0 ||
    index >= projects.length
  ) {
    return null;
  }

  return projects[index];
}

