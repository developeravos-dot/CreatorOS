import { useCallback, useEffect, useMemo, useState } from "react";
import {
  aiContentApi,
  type AiContentAction,
  type AiContentStatus,
} from "./ai-content-api";

type ToolDefinition = {
  id: AiContentAction;
  title: string;
  description: string;
  button: string;
};

const tools: ToolDefinition[] = [
  {
    id: "ideas",
    title: "توليد الأفكار",
    description: "ابتكار أفكار أصلية متوافقة مع الجمهور والمنصة.",
    button: "توليد الأفكار",
  },
  {
    id: "scripts",
    title: "كتابة السكربت",
    description: "تحويل الفكرة إلى سكربت منظم وقابل للإنتاج.",
    button: "إنشاء السكربت",
  },
  {
    id: "optimize",
    title: "تحسين المحتوى",
    description: "تكييف المحتوى مع YouTube أو TikTok.",
    button: "تحسين المحتوى",
  },
  {
    id: "review",
    title: "مراجعة الجودة",
    description: "تحليل الجودة والوضوح والجاذبية قبل الإنتاج.",
    button: "مراجعة المحتوى",
  },
  {
    id: "production-package",
    title: "حزمة الإنتاج",
    description: "إنشاء حزمة متكاملة تساعد على تنفيذ المحتوى.",
    button: "إنشاء حزمة الإنتاج",
  },
];

export function AiContentStudio() {
  const [status, setStatus] = useState<AiContentStatus | null>(null);
  const [topic, setTopic] = useState("");
  const [platform, setPlatform] = useState("YouTube");
  const [audience, setAudience] = useState("الجمهور العام");
  const [content, setContent] = useState("");
  const [activeAction, setActiveAction] =
    useState<AiContentAction | null>(null);
  const [result, setResult] = useState<unknown>(null);
  const [error, setError] = useState("");

  const loadStatus = useCallback(async () => {
    try {
      setError("");
      setStatus(await aiContentApi.status());
    } catch (requestError) {
      setStatus(null);
      setError(
        requestError instanceof Error
          ? requestError.message
          : "تعذر الاتصال بمحرك المحتوى الذكي.",
      );
    }
  }, []);

  useEffect(() => {
    void loadStatus();
  }, [loadStatus]);

  const connected = status?.status === "operational";

  const output = useMemo(() => {
    if (result === null) {
      return "";
    }

    return typeof result === "string"
      ? result
      : JSON.stringify(result, null, 2);
  }, [result]);

  const execute = async (action: AiContentAction) => {
    const source = content.trim() || topic.trim();

    if (!source) {
      setError("أدخل موضوعًا أو محتوى أولًا.");
      return;
    }

    try {
      setError("");
      setResult(null);
      setActiveAction(action);

      const response = await aiContentApi.run(action, {
        topic: topic.trim(),
        idea: topic.trim(),
        content: source,
        platform,
        audience,
        duration: "60-90 seconds",
        language: "Arabic",
      });

      setResult(response);
    } catch (requestError) {
      setError(
        requestError instanceof Error
          ? requestError.message
          : "فشلت عملية الذكاء الاصطناعي.",
      );
    } finally {
      setActiveAction(null);
    }
  };

  return (
    <section style={studioStyles.wrapper}>
      <div style={studioStyles.hero}>
        <div>
          <div style={studioStyles.eyebrow}>AI CONTENT STUDIO</div>
          <h2 style={studioStyles.title}>استوديو المحتوى الذكي</h2>
          <p style={studioStyles.description}>
            مركز موحد لتوليد الأفكار والسكربتات وتحسين المحتوى
            ومراجعته وتجهيزه للإنتاج.
          </p>
        </div>

        <button
          type="button"
          style={studioStyles.statusButton}
          onClick={() => void loadStatus()}
        >
          <span
            style={{
              ...studioStyles.statusDot,
              background: connected ? "#42e8a1" : "#ff5f74",
            }}
          />
          {connected ? "المحرك متصل" : "إعادة الاتصال"}
        </button>
      </div>

      {status && (
        <div style={studioStyles.systemBar}>
          <strong>{status.module}</strong>
          <span>الإصدار: {status.version}</span>
          <span>
            القدرات: {status.capabilities?.length ?? 0}
          </span>
        </div>
      )}

      {error && <div style={studioStyles.error}>{error}</div>}

      <div style={studioStyles.formGrid}>
        <label style={studioStyles.field}>
          <span style={studioStyles.label}>الموضوع أو الفكرة</span>
          <input
            value={topic}
            onChange={(event) => setTopic(event.target.value)}
            placeholder="مثال: مستقبل السيارات ذاتية القيادة"
            style={studioStyles.input}
          />
        </label>

        <label style={studioStyles.field}>
          <span style={studioStyles.label}>المنصة</span>
          <select
            value={platform}
            onChange={(event) => setPlatform(event.target.value)}
            style={studioStyles.input}
          >
            <option value="YouTube">YouTube</option>
            <option value="TikTok">TikTok</option>
            <option value="Instagram">Instagram</option>
            <option value="Both">YouTube + TikTok</option>
          </select>
        </label>

        <label style={studioStyles.field}>
          <span style={studioStyles.label}>الجمهور</span>
          <input
            value={audience}
            onChange={(event) => setAudience(event.target.value)}
            style={studioStyles.input}
          />
        </label>
      </div>

      <label style={studioStyles.field}>
        <span style={studioStyles.label}>
          النص أو المحتوى المراد تطويره
        </span>
        <textarea
          value={content}
          onChange={(event) => setContent(event.target.value)}
          placeholder="يمكنك إدخال فكرة مختصرة أو نص كامل..."
          style={studioStyles.textarea}
        />
      </label>

      <div style={studioStyles.toolsGrid}>
        {tools.map((tool) => (
          <article key={tool.id} style={studioStyles.toolCard}>
            <div style={studioStyles.toolIcon}>✦</div>
            <h3 style={studioStyles.toolTitle}>{tool.title}</h3>
            <p style={studioStyles.toolDescription}>
              {tool.description}
            </p>
            <button
              type="button"
              disabled={!connected || activeAction !== null}
              onClick={() => void execute(tool.id)}
              style={{
                ...studioStyles.actionButton,
                opacity:
                  !connected || activeAction !== null ? 0.55 : 1,
              }}
            >
              {activeAction === tool.id
                ? "جارٍ التنفيذ..."
                : tool.button}
            </button>
          </article>
        ))}
      </div>

      <div style={studioStyles.outputPanel}>
        <div style={studioStyles.outputHeader}>
          <div>
            <div style={studioStyles.eyebrow}>AI OUTPUT</div>
            <h3 style={studioStyles.outputTitle}>نتيجة المحرك</h3>
          </div>

          {output && (
            <button
              type="button"
              style={studioStyles.copyButton}
              onClick={() => void navigator.clipboard.writeText(output)}
            >
              نسخ النتيجة
            </button>
          )}
        </div>

        {output ? (
          <pre style={studioStyles.output}>{output}</pre>
        ) : (
          <div style={studioStyles.emptyOutput}>
            ستظهر نتيجة العملية هنا.
          </div>
        )}
      </div>
    </section>
  );
}

const studioStyles: Record<string, React.CSSProperties> = {
  wrapper: {
    display: "grid",
    gap: 20,
  },
  hero: {
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between",
    gap: 20,
    padding: 24,
    borderRadius: 20,
    background:
      "linear-gradient(135deg, rgba(114,92,255,.22), rgba(44,207,255,.08))",
    border: "1px solid rgba(255,255,255,.1)",
  },
  eyebrow: {
    fontSize: 12,
    letterSpacing: 2,
    opacity: 0.65,
  },
  title: {
    margin: "8px 0",
    fontSize: 28,
  },
  description: {
    margin: 0,
    opacity: 0.72,
    lineHeight: 1.8,
  },
  statusButton: {
    minWidth: 150,
    border: "1px solid rgba(255,255,255,.12)",
    borderRadius: 999,
    padding: "11px 15px",
    background: "rgba(0,0,0,.2)",
    color: "inherit",
    cursor: "pointer",
  },
  statusDot: {
    width: 9,
    height: 9,
    borderRadius: "50%",
    display: "inline-block",
    marginLeft: 9,
  },
  systemBar: {
    display: "flex",
    flexWrap: "wrap",
    gap: 18,
    padding: "14px 18px",
    borderRadius: 14,
    background: "rgba(255,255,255,.045)",
    border: "1px solid rgba(255,255,255,.08)",
    fontSize: 13,
  },
  error: {
    padding: 14,
    borderRadius: 12,
    background: "rgba(255,95,116,.12)",
    border: "1px solid rgba(255,95,116,.3)",
  },
  formGrid: {
    display: "grid",
    gridTemplateColumns: "2fr 1fr 1fr",
    gap: 14,
  },
  field: {
    display: "grid",
    gap: 8,
  },
  label: {
    fontSize: 13,
    fontWeight: 700,
  },
  input: {
    width: "100%",
    boxSizing: "border-box",
    borderRadius: 12,
    border: "1px solid rgba(255,255,255,.1)",
    background: "rgba(255,255,255,.05)",
    color: "inherit",
    padding: "13px 14px",
  },
  textarea: {
    width: "100%",
    minHeight: 150,
    resize: "vertical",
    boxSizing: "border-box",
    borderRadius: 14,
    border: "1px solid rgba(255,255,255,.1)",
    background: "rgba(255,255,255,.05)",
    color: "inherit",
    padding: 15,
    lineHeight: 1.7,
  },
  toolsGrid: {
    display: "grid",
    gridTemplateColumns: "repeat(auto-fit, minmax(210px, 1fr))",
    gap: 14,
  },
  toolCard: {
    padding: 18,
    borderRadius: 16,
    background: "rgba(255,255,255,.045)",
    border: "1px solid rgba(255,255,255,.08)",
  },
  toolIcon: {
    fontSize: 24,
  },
  toolTitle: {
    margin: "12px 0 8px",
  },
  toolDescription: {
    minHeight: 52,
    margin: "0 0 16px",
    opacity: 0.7,
    lineHeight: 1.6,
  },
  actionButton: {
    width: "100%",
    border: 0,
    borderRadius: 11,
    padding: "11px 13px",
    background: "linear-gradient(135deg, #765cff, #42cfee)",
    color: "#fff",
    fontWeight: 800,
    cursor: "pointer",
  },
  outputPanel: {
    padding: 20,
    borderRadius: 18,
    background: "rgba(0,0,0,.18)",
    border: "1px solid rgba(255,255,255,.08)",
  },
  outputHeader: {
    display: "flex",
    alignItems: "center",
    justifyContent: "space-between",
    gap: 12,
    marginBottom: 14,
  },
  outputTitle: {
    margin: "5px 0 0",
  },
  copyButton: {
    border: "1px solid rgba(255,255,255,.12)",
    borderRadius: 10,
    padding: "9px 12px",
    background: "rgba(255,255,255,.06)",
    color: "inherit",
    cursor: "pointer",
  },
  output: {
    margin: 0,
    whiteSpace: "pre-wrap",
    wordBreak: "break-word",
    direction: "rtl",
    textAlign: "right",
    lineHeight: 1.8,
    fontFamily: "inherit",
  },
  emptyOutput: {
    padding: 28,
    textAlign: "center",
    opacity: 0.55,
  },
};