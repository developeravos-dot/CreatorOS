model MediaDomainEvent {
  id         String   @id
  eventType  String
  entityType String
  entityId   String
  payload    Json?
  occurredAt DateTime @default(now())

  @@index([eventType])
  @@index([entityType, entityId])
  @@map("media_domain_events")
}

model Sponsor {
  id            String                   @id @default(cuid())
  name          String
  companyKey    String                   @unique
  industry      String?
  country       String?
  website       String?
  status        SponsorStatus            @default(DISCOVERED)
  metadata      Json?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  brands        Brand[]
  interactions  SponsorInteraction[]
