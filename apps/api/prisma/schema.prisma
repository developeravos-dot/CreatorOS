// ===== MEGA PACK 11: EVENT & MESSAGING PLATFORM =====
enum EventTopicStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  DISABLED
}

enum EventSubscriptionStatus {
  ACTIVE
  PAUSED
  DISABLED
}

enum EventMessagePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum EventDeliveryStatus {
  PENDING
  PROCESSING
  RETRYING
  DELIVERED
  FAILED
  DEAD_LETTER
  CANCELLED
}

enum EventReplayStatus {
  PLANNED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model EventTopic {
  id            String              @id @default(cuid())
  topicKey      String              @unique
  name          String
  description   String?
  status        EventTopicStatus    @default(ACTIVE)
  partitions    Int                 @default(1)
  retentionDays Int                 @default(30)
  ordered       Boolean             @default(false)
  schema        Json
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  subscriptions EventSubscription[]
  messages      EventMessage[]
  replays       EventReplay[]

  @@index([status, updatedAt])
}

model EventSubscription {
  id                String                  @id @default(cuid())
  topicId           String
  subscriptionKey   String                  @unique
  name              String
  consumerType      String
  endpoint          String?
  status            EventSubscriptionStatus @default(ACTIVE)
  maxAttempts       Int                     @default(5)
  retryDelaySeconds Int                     @default(60)
  filter            Json
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  topic             EventTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  deliveries        EventDelivery[]
  replays           EventReplay[]

  @@index([topicId, status])
}

model EventMessage {
  id             String               @id @default(cuid())
  topicId        String
  eventName      String
  eventVersion   String
  producer       String
  aggregateType  String?
  aggregateId    String?
  correlationId  String?
  causationId    String?
  idempotencyKey String?              @unique
  priority       EventMessagePriority @default(NORMAL)
  payload        Json
  headers        Json
  occurredAt     DateTime             @default(now())
  topic          EventTopic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  deliveries     EventDelivery[]

  @@index([topicId, occurredAt])
  @@index([eventName, occurredAt])
  @@index([correlationId])
}

model EventDelivery {
  id             String              @id @default(cuid())
  messageId      String
  subscriptionId String
  status         EventDeliveryStatus @default(PENDING)
  attempts       Int                 @default(0)
  response       String?
  lastError      String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  message        EventMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  subscription   EventSubscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  deadLetter     EventDeadLetter?

  @@unique([messageId, subscriptionId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId, status])
}

model EventDeadLetter {
  id         String        @id @default(cuid())
  deliveryId String        @unique
  reason     String
  payload    Json
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?
  delivery   EventDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([resolvedAt, createdAt])
}

model EventReplay {
  id             String             @id @default(cuid())
  topicId        String
  subscriptionId String?
  replayKey      String             @unique
  fromMessageId  String?
  toMessageId    String?
  limit          Int                @default(1000)
  status         EventReplayStatus  @default(PLANNED)
  processedCount Int                @default(0)
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  topic          EventTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  subscription   EventSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([topicId])
}

enum ObsMetricKind {
  COUNTER
  GAUGE
  HISTOGRAM
}

enum ObsHealthStatus {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum ObsLogLevel {
  TRACE
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum ObsAlertSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum ObsAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

model ObsMetric {
  id         String        @id @default(cuid())
  metricKey  String
  service    String
  kind       ObsMetricKind
  value      Float
  unit       String?
  labels     Json
  observedAt DateTime      @default(now())
