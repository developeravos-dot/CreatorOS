export type AiContentStatus = {
  success: boolean;
  module: string;
  status: string;
  version: string;
  capabilities: string[];
};

export type AiContentAction =
  | "ideas"
  | "scripts"
  | "optimize"
  | "review"
  | "production-package";

const API_ROOT =
  (import.meta.env.VITE_API_URL as string | undefined)?.replace(/\/$/, "") ??
  "http://localhost:3000/api/v1";

const AI_CONTENT_ROOT = `${API_ROOT}/enterprise/ai-content`;

async function request<T>(
  path: string,
  options?: RequestInit,
): Promise<T> {
  const response = await fetch(`${AI_CONTENT_ROOT}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(options?.headers ?? {}),
    },
  });

  const text = await response.text();
  let data: unknown = null;

  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      data = text;
    }
  }

  if (!response.ok) {
    const message =
      typeof data === "object" &&
      data !== null &&
      "message" in data
        ? String((data as { message: unknown }).message)
        : `AI Content request failed (${response.status})`;

    throw new Error(message);
  }

  return data as T;
}

export const aiContentApi = {
  status(): Promise<AiContentStatus> {
    return request<AiContentStatus>("/status");
  },

  run(
    action: AiContentAction,
    payload: Record<string, unknown>,
  ): Promise<unknown> {
    return request<unknown>(`/${action}`, {
      method: "POST",
      body: JSON.stringify(payload),
    });
  },
};