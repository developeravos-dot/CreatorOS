model ObsAlertRule {
  id                      String           @id @default(cuid())
  ruleKey                 String           @unique
  name                    String
  metricKey               String
  operator                String
  threshold               Float
  severity                ObsAlertSeverity
  evaluationWindowMinutes Int              @default(5)
  enabled                 Boolean          @default(true)
  labels                  Json
  events                  ObsAlertEvent[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([enabled, severity])
  @@index([metricKey])
}

model ObsAlertEvent {
  id           String           @id @default(cuid())
  ruleId       String?
  fingerprint  String           @unique
  title        String
  message      String
  severity     ObsAlertSeverity
  status       ObsAlertStatus   @default(OPEN)
  service      String?
  currentValue Float?
  note         String?
  triggeredAt  DateTime         @default(now())
  resolvedAt   DateTime?
  metadata     Json
  rule         ObsAlertRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status, severity])
  @@index([service, triggeredAt])
  @@index([ruleId])
}

