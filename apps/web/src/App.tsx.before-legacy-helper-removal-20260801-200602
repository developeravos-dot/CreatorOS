          </div>
        </div>

        <nav style={styles.nav}>
          <NavButton
            active={view === "dashboard"}
            icon="⌂"
            label="لوحة التحكم"
            onClick={() => setView("dashboard")}
          />
          <NavButton
            active={view === "projects"}
            icon="▦"
            label="المشاريع"
            onClick={() => setView("projects")}
          />
          <NavButton
            active={view === "scripts"}
            icon="✎"
            label="محرر السكربت"
            onClick={() => setView("scripts")}
          />
          <NavButton
            active={view === "calendar"}
            icon="▣"
            label="تقويم المحتوى"
            onClick={() => setView("calendar")}
          />
          <NavButton
            active={view === "prompts"}
